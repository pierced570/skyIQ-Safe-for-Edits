                            var maxlanding = $(aircraft).data("maxlanding");
                            var reserve = $(aircraft).data("reserve");
                            var taxifuel = $(aircraft).data("taxifuel");
                            var maxramp = $(aircraft).data("maxramp");
                            var baggageNoPax = $(aircraft).data("baggage-wo-pax")
                            var defaultcrew = $(aircraft).data("defaultcrew");

                            newLeg.find("input[name$='MaxLandingWeight']").val(maxlanding);
                            newLeg.find("input[name$='MaxTakeoffWeight']").val(takeoff);
                            newLeg.find("input[name$='Reserve']").val(reserve);
                            newLeg.find("input[name$='TaxiFuelBurn']").val(taxifuel);
                            newLeg.find("input[name$='MaxRampWeight']").val(maxramp);
                            newLeg.find("input[name$='LegNum']").val(newLegNum);
                            newLeg.find("input[name$='Baggage']").val(baggageNoPax);
                            newLeg.find("input[name$='CrewWeight']").val(defaultcrew);
                            
                            //fuel prices 
                            var leg = response[i] 
