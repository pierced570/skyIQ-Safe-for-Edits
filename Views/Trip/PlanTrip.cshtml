                                currentAttr.attr('for', newAttrId);
                            })
                            newLeg.find("[name='confirm-leg-1']").attr("name", "confirm-leg-" + newLegNum);
                            newLeg.find("input").not('input[type="radio"]').val('');
                            newLeg.find(".confirm-leg-option.no").click();
