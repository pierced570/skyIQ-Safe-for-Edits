            $("#remove-leg-modal").modal("hide");           
        })
        $("body").on("click", ".remove-leg", function(){
            var removedLegNum = parseInt($(this).closest(".leg").attr("data-leg"))
            var nextLeg = $(this).closest(".trip-details").find(".leg[data-leg='" + (removedLegNum + 1) + "']")
            
            if(nextLeg && !$(nextLeg).is(":visible")){
                $(this).closest(".confirm-leg-div").find(".confirm-leg-option.yes").click();
            }

            $(".trip-details .leg").each(function(){
                var legNum = parseInt($(this).attr("data-leg"))
                if(legNum > removedLegNum){
                    legNum--

                    $(this).attr("data-leg", legNum);
                    $(this).find(".leg-title .leg-num").text(legNum);
                    $(this).find(".confirm-text .leg-num").text(legNum);
                    $(this).find("[name^='confirm-leg-']").attr("name", "confirm-leg-" + legNum);
                    $(this).find("input[name$='LegNum']").val(legNum);

                }
            })
            $(this).closest(".leg").find('[name$="LegNum"]').val(-1);
            $(this).closest(".leg").attr("data-leg", "-1").slideUp("slow", function(){

                var numValidatedLegs = $("input[name^='confirm-leg'][value='true']:checked").length;

                if (numValidatedLegs >= numLegs) {
                    let valid = $("form.plan-trip-form").valid();
                    if(valid)
                    {
                        // $(".trip-details").hide();
                        // $(".header-plan-trip").hide();
                        // $(".trip-fuel-details").show();
                        $(".next-btn").attr("disabled", false);
                    }
                    else {
                        $(".next-btn").attr("disabled", true);
                    }
                }
                else {
                    $(".next-btn").attr("disabled", true);
                }
            });

            $(".trip-fuel-details .fuel-burn-row[data-leg='" + removedLegNum + "']").attr("data-leg", "-1").slideUp("slow");

            $(".trip-fuel-details .fuel-burn-row").each(function(){
                var legNum = parseInt($(this).attr("data-leg"))
                if(legNum > removedLegNum){
                    legNum--

                    $(this).attr("data-leg", legNum);
                    $(this).find("span.leg-num").text(legNum);
                    var details = $(".trip-details .leg[data-leg=" + legNum + "]"); 
                    $(this).find(".destination").text($(details).find("input[name$='Destination']").val());
                    $(this).find(".departure").text($(details).find("input[name$='Departure']").val());
                }
            })


            numLegs--;
            if(numLegs == 1){
                $(".remove-leg").attr("disabled", "disabled")
                $(".confirm-leg-option.no").attr("disabled", "disabled").addClass("disabled")
            }
            else {
                $(".remove-leg").removeAttr("disabled")
                $(".confirm-leg-option.no").removeAttr("disabled").removeClass("disabled")
            }
            $(".confirm-text .total-legs").text(numLegs);
        })

       $("body").on("change", "input[name$='Destination']", function(){
           var leg = $(this).closest(".leg").data("leg");
           $(".trip-fuel-details .fuel-burn-row[data-leg=" + leg + "] .destination").text($(this).val());
       })
       $("body").on("change", "input[name$='Departure']", function(){
           var leg = $(this).closest(".leg").data("leg");
           $(".trip-fuel-details .fuel-burn-row[data-leg=" + leg + "] .departure").text($(this).val());

       })


        $("body").on("click", ".card-btn.add-fuel-price",function() {
            var btnrow = $(this).closest(".col");
            var leg = parseInt($(this).attr("data-leg"));
            var nextIdx = parseInt($(this).attr("data-idx")) + 1;
            var fuelPriceRow = `<div class="col-6" data-idx="${nextIdx}">
                        <label class="" for="Legs_${leg}__DepartureFuelPrices_X__Price">Price</label>
                        <div class="amount-input"><span class="dollar-sign">$</span><input class="" type="number" required="" data-val="true" data-val-number="The field Price must be a number." data-val-required="The Price field is required." id="Legs_${leg}__DepartureFuelPrices_${nextIdx}__Price" name="Legs[${leg}].DepartureFuelPrices[${nextIdx}].Price"/></div></div>                            
                        </div>
                        <div class="col-6" data-idx="${nextIdx}">
                        <label class="" for="Legs_${leg}__DepartureFuelPrices_${nextIdx}__MinFuel">Min Fuel (gal)</label>
                        <input class="valid" type="number" required="" data-val="true" data-val-number="The field MinFuel must be a number." data-val-required="The MinFuel field is required." id="Legs_${leg}__DepartureFuelPrices_${nextIdx}__MinFuel" name="Legs[${leg}].DepartureFuelPrices[${nextIdx}].MinFuel"/>
                        </div>`

            $(btnrow).before(fuelPriceRow);
            $(this).attr("data-idx", nextIdx);
            $(btnrow).find(".remove-fuel-price").attr("data-idx", nextIdx);
        })
        $("body").on("click", ".card-btn.remove-fuel-price",function() {
            var btnrow = $(this).closest(".col");
            var idx = parseInt($(this).attr("data-idx"));
            var lastIdx = idx - 1;
            $(this).closest(".row").find("div.col-6[data-idx='" + idx + "']").remove(); 
            $(this).attr("data-idx", lastIdx)
            $(btnrow).find(".add-fuel-price").attr("data-idx", lastIdx);
        })
        $("body").on("change", "input[name$='CrewWeight'], input[name$='PassengerWeights']", function() {
            $(this).val($(this).val().replace(/[^0-9.,]+/g, ''))
        })
    })
</script>
