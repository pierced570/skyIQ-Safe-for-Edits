@{
    ViewData["Title"] = "Plan a Trip";
}

<div class="container">
    <h1 class="display-4 mb-4">Plan a Trip</h1>
    
        <form class="plan-trip-form" asp-action="PlanTrip" method="post" enctype="multipart/form-data">
            <div>
               <label for="formFile" class="dropzone" id="dropzone">
        <p>Upload your itinerary</p>
        <button type="button" class="btn btn-outline-secondary">Choose File</button>
        <p id="file-name">No file chosen</p>
    </label>
    <input class="file-input" type="file" name="formFile" id="formFile" required accept=".pdf">




            </div>
